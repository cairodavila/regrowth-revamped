{
  "schemaVersion": 1,
  "id": "regrowth",
  "version": "${version}",

  "name": "Regrowth: Revamped",
  "description": "An unofficial Fabric continuation of Regrowth with adaptive villages and modern Minecraft support.",
  "authors": [
    "MacTso",
    "Lupicus"
  ],
  "contributors": [
    "Cairo D'Avila"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/regrowth-revamped",
    "sources": "https://github.com/cairodavila/regrowth-revamped",
    "issues": "https://github.com/cairodavila/regrowth-revamped/issues"
  },

  "license": "MIT",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mactso.regrowth.Main"
    ]
  },
  "mixins": [
    "regrowth.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.3",
